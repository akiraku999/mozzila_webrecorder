{
  "manifest_version": 3,
  "name": "allrecorder by akiraku",
  "version": "1.0.0",
  "description": "Захват живого звука активной вкладки Firefox, интерактивная обрезка и локальное сохранение в MP3 320 kbps.",
  "browser_specific_settings": {
    "gecko": {
      "id": "allrecorder@internal.addon",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "allrecorder by akiraku",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hook.js"],
      "matches": ["*://*/*", "<all_urls>"]
    }
  ]
}